CONFIG_SOC_SERIES_NRF52X=y
CONFIG_SOC_NRF52840_QIAA=y
CONFIG_BOARD_PIANTOR_PRO_BT_LEFT=y

# 1. POWER MANAGEMENT (The Battery Savers)
CONFIG_ZMK_SLEEP=y
# 15 minutes to deep sleep (900,000ms)
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=900000
# 30 seconds to idle (dim screen/low power radio)
CONFIG_ZMK_IDLE_TIMEOUT=30000
# Disable DC-DC High Voltage (Reduces quiescent drain)
CONFIG_BOARD_ENABLE_DCDC_HV=n

# 2. DISABLE VAMPIRE DRAINS
# RGB is the #1 reason for 12-hour drain. Disabling drivers entirely.
CONFIG_ZMK_RGB_UNDERGLOW=n
CONFIG_WS2812_STRIP=n
# Disable ZMK Studio (Alpha) to ensure stable sleep states
CONFIG_ZMK_STUDIO=n

# 3. DISPLAY SETTINGS
CONFIG_ZMK_DISPLAY=y
# Ensures the screen stays efficient
CONFIG_ZMK_DISPLAY_STATUS_SCREEN_BUILTIN=y

# 4. CORE FUNCTIONALITY
CONFIG_ARM_MPU=y
CONFIG_GPIO=y
CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# 5. CONNECTIVITY
CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y
CONFIG_I2C=y
CONFIG_I2C_NRFX=y
CONFIG_PINCTRL=y

# Improved connection stability for Mac
CONFIG_ZMK_BLE_EXPERIMENTAL_CONN=y
# Windows Battery Reporting Fix (Safe to keep for Mac)
CONFIG_BT_GATT_ENFORCE_SUBSCRIPTION=n
